---
pagination:
  data: collections.publishedHotel
  size: 1
  alias: hotel
permalink: "{% if hotel.data.published !== false %}/hotels/{{ hotel.data.country }}/{{ hotel.data.slug }}/{% else %}false{% endif %}"
layout: layouts/base.njk
bodyClass: "country-page hotel-detail-page"
eleventyComputed:
  title: "{{ hotel.data.seo_title or hotel.data.title + ' - EvolveClub' }}"
  description: "{{ hotel.data.seo_description or hotel.data.subtitle }}"
---

{% set countryEntry = collections.country | findByData("slug", hotel.data.country) %}
{% set countryTitle = countryEntry.data.title if countryEntry else hotel.data.country %}
{% set tierLabel = "Deluxe" %}
{% if hotel.data.tier == "premium" %}{% set tierLabel = "Premium" %}{% endif %}
{% if hotel.data.tier == "business" %}{% set tierLabel = "Business" %}{% endif %}
{% if hotel.data.tierLabel %}{% set tierLabel = hotel.data.tierLabel %}{% endif %}
{% set heroImages = [] %}
{% if hotel.data.cover %}
  {% set heroImages = (heroImages.push(hotel.data.cover | optimizedImage), heroImages) %}
{% endif %}
{% if hotel.data.gallery and hotel.data.gallery.length %}
  {% for item in hotel.data.gallery %}
    {% set heroImages = (heroImages.push((item.image or item) | optimizedImage), heroImages) %}
  {% endfor %}
{% endif %}

<main id="top">
  <section class="hotel-detail-hero" data-hotel-hero data-hero-images="{{ heroImages | join('|') }}" style="--hotel-hero-image: url('{{ heroImages[0] or (hotel.data.cover | optimizedImage) }}'); --hotel-next-image: url('{{ heroImages[0] or (hotel.data.cover | optimizedImage) }}');">
    <div class="hotel-detail-inner">
      <a class="country-back" data-history-back href="/countries/{{ hotel.data.country }}/#hotels"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg> Назад к отелям</a>
      <span class="hotel-stars" aria-label="Отель">{{ hotel.data.stars or "★★★★★" }} <span class="hotel-rating-label">{{ tierLabel }}</span></span>
      <h1>{{ hotel.data.title }}</h1>
      <span class="hotel-location"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>{{ countryTitle }}{% if hotel.data.location %}, {{ hotel.data.location }}{% endif %}</span>
    </div>
    <div class="hotel-hero-actions" aria-label="Заявка по отелю">
      <button type="button" class="primary-button" data-modal-open="hotel-request">Оставить заявку</button>
    </div>
    {% if heroImages.length > 1 %}
      <div class="hotel-hero-controls" aria-label="Фотографии отеля">
        <button type="button" data-hero-prev aria-label="Предыдущее фото"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></button>
        <span><b data-hero-current>01</b>/<b data-hero-total>{{ "0" if heroImages.length < 10 }}{{ heroImages.length }}</b></span>
        <button type="button" data-hero-next aria-label="Следующее фото"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
      </div>
    {% endif %}
  </section>

  <section class="hotel-detail-main">
    <section class="hotel-content-section hotel-about-feature">
      <div>
        <h2>{{ hotel.data.about_title or hotel.data.subtitle }}</h2>
        {{ hotel.templateContent | safe }}
      </div>
      {% if hotel.data.facts and hotel.data.facts.length %}
        <ul class="hotel-facts">
          {% for fact in hotel.data.facts %}
            <li>
              {% if loop.index == 1 %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              {% elif loop.index == 2 %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384Z"/></svg>
              {% elif loop.index == 3 %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M2 20a2.4 2.4 0 0 0 2 1 2.4 2.4 0 0 0 2-1 2.4 2.4 0 0 1 2-1 2.4 2.4 0 0 1 2 1 2.4 2.4 0 0 0 2 1 2.4 2.4 0 0 0 2-1 2.4 2.4 0 0 1 2-1 2.4 2.4 0 0 1 2 1 2.4 2.4 0 0 0 2 1 2.4 2.4 0 0 0 2-1"/><path d="M4 18 3 9l9-6 9 6-1 9"/><path d="M12 3v15"/><path d="M3 9h18"/></svg>
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/></svg>
              {% endif %}
              <span>{{ fact.label }}</span>
              <p>{{ fact.text }}</p>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </section>

    {% if hotel.data.rooms and hotel.data.rooms.length %}
      <section class="hotel-content-section">
        <span>Проживание</span>
        <h2>{{ hotel.data.rooms_title or "Варианты номеров и вилл" }}</h2>
        {% if hotel.data.rooms_intro %}
          <p>{{ hotel.data.rooms_intro }}</p>
        {% endif %}
        <div class="room-grid room-grid-detailed">
          {% for room in hotel.data.rooms %}
            {% set roomImages = [] %}
            {% if room.images and room.images.length %}
              {% for item in room.images %}
                {% set roomImages = (roomImages.push((item.image or item) | optimizedImage), roomImages) %}
              {% endfor %}
            {% endif %}
            {% set firstImage = roomImages[0] or (hotel.data.cover | optimizedImage) %}
            <article class="room-card">
              <div class="room-gallery" data-room-gallery data-room-images="{{ roomImages | join('|') }}">
                <img src="{{ firstImage }}" alt="{{ room.title }}" loading="lazy">
                <button type="button" data-room-prev aria-label="Предыдущее фото"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></button>
                <button type="button" data-room-next aria-label="Следующее фото"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
              </div>
              {% if room.type %}
                <span>{{ room.type }}</span>
              {% endif %}
              <h3>{{ room.title }}</h3>
              <p>{{ room.description }}</p>
              {% if room.area or room.capacity %}
                <p>
                  {% if room.area %}<b>{{ room.area }}</b>{% endif %}
                  {% if room.area and room.capacity %} · {% endif %}
                  {% if room.capacity %}{{ room.capacity }}{% endif %}
                </p>
              {% endif %}
              <div class="room-card-actions">
                <button
                  type="button"
                  class="room-select-button"
                  data-modal-open="hotel-request"
                  data-request-hotel="{{ hotel.data.title }}"
                  data-request-country="{{ countryTitle }}"
                  data-request-room="{{ room.title }}"
                  data-request-room-type="{{ room.type or '' }}"
                  data-request-room-area="{{ room.area or '' }}"
                  data-request-room-capacity="{{ room.capacity or '' }}"
                >
                  Выбрать
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                </button>
              </div>
            </article>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if hotel.data.gallery and hotel.data.gallery.length %}
      <section class="hotel-photo-mosaic" aria-label="Фотографии отеля">
        {% for item in hotel.data.gallery %}
          <img src="{{ (item.image or item) | optimizedImage }}" alt="{{ hotel.data.title }}" loading="lazy">
        {% endfor %}
      </section>
    {% endif %}

    {% if hotel.data.sections and hotel.data.sections.length %}
      {% for section in hotel.data.sections %}
        {% if loop.index0 % 2 == 0 %}
          <div class="hotel-two-column">
        {% endif %}
            <section class="hotel-content-section">
              <h2>{{ section.title }}</h2>
              <div><p>{{ section.body }}</p></div>
            </section>
        {% if loop.index0 % 2 == 1 or loop.last %}
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}

    <div class="hotel-bottom-action">
      <a class="ghost-button country-ghost-button" href="#top">Наверх <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg></a>
      <button type="button" class="primary-button" data-modal-open="hotel-request">Оставить заявку</button>
    </div>
  </section>
</main>

<div class="modal" id="hotel-request" data-modal aria-hidden="true">
  <div class="modal-backdrop" data-modal-close></div>
  <div class="modal-panel request-modal-panel" role="dialog" aria-modal="true" aria-labelledby="hotel-request-title">
    <button type="button" class="modal-close" data-modal-close aria-label="Закрыть">×</button>
    <h2 id="hotel-request-title">Оставить заявку</h2>
    <form class="request-form" action="/send-request" method="post" data-request-form>
      <label for="hotel-request-name">
        <span>Имя</span>
        <input type="text" id="hotel-request-name" name="name" placeholder="Ваше имя" required>
      </label>
      <label for="hotel-request-contact">
        <span>Контакт</span>
        <input type="text" id="hotel-request-contact" name="contact" placeholder="+7 (925) 141-50-10" required>
      </label>
      <label for="hotel-request-villa">
        <span>Отель / размещение</span>
        <input type="text" id="hotel-request-villa" name="hotel" value="{{ hotel.data.title }}">
      </label>
      <div class="request-date-grid">
        <label for="hotel-request-date-start">
          <span>Начало поездки</span>
          <input type="date" id="hotel-request-date-start" name="date_start">
        </label>
        <label for="hotel-request-date-end">
          <span>Конец поездки</span>
          <input type="date" id="hotel-request-date-end" name="date_end">
        </label>
      </div>
      <label for="hotel-request-message">
        <span>Пожелания</span>
        <textarea id="hotel-request-message" name="message" rows="4" placeholder="Гости, бюджет и важные детали"></textarea>
      </label>
      <button type="submit" class="primary-button">Отправить заявку</button>
      <p class="form-status" data-form-status></p>
    </form>
  </div>
</div>
