---
pagination:
  data: collections.country
  size: 1
  alias: country
permalink: "{% if country.data.published !== false %}/countries/{{ country.data.slug }}/{% else %}false{% endif %}"
layout: layouts/base.njk
bodyClass: "country-page"
eleventyComputed:
  title: "{{ country.data.seo_title or country.data.title + ' - EvolveClub' }}"
  description: "{{ country.data.seo_description or country.data.subtitle }}"
---

<main id="top">
  <section class="country-hero" style="background-image: linear-gradient(90deg, rgba(17, 22, 21, .78), rgba(17, 22, 21, .46) 46%, rgba(17, 22, 21, .22)), linear-gradient(0deg, rgba(17, 22, 21, .78), rgba(17, 22, 21, .08) 58%), url('{{ country.data.cover }}');">
    <div class="country-hero-inner">
      <a class="country-back" data-history-back href="/#destinations" data-return-section="{{ country.data.region }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg> Назад</a>
      <h1>{{ country.data.title }}</h1>
      <p>{{ country.data.subtitle }}</p>
      <div class="country-actions" aria-label="Информация о направлении">
        <a class="primary-button" href="#hotels">Смотреть отели <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
      </div>
    </div>
  </section>

  <section class="country-hotels" id="hotels">
    <div class="section-head">
      <div>
        <p class="eyebrow">Наши рекомендации</p>
      </div>
    </div>

    {% set tiers = [
      { value: "deluxe", label: "Deluxe" },
      { value: "premium", label: "Premium" },
      { value: "business", label: "Business" }
    ] %}
    {% set allHotels = collections.hotel | whereEquals("data.country", country.data.slug) | whereTruthy("data.published") | sortByOrder %}

    {% for tier in tiers %}
      {% set tierHotels = allHotels | whereEquals("data.tier", tier.value) %}
      {% if tierHotels.length %}
        <div class="hotel-group">
          <h2>{{ tier.label }}</h2>
          <div class="hotel-grid">
            {% for hotel in tierHotels %}
              <a class="hotel-card hotel-card-link" href="/hotels/{{ hotel.data.country }}/{{ hotel.data.slug }}/">
                <div class="hotel-card-image" style="background-image: url('{{ hotel.data.cover }}');"></div>
                <div class="hotel-card-body">
                  <span class="hotel-card-rating">{{ hotel.data.stars or "★★★★★" }}{% if hotel.data.location %} <b>{{ hotel.data.location }}</b>{% endif %}</span>
                  <h3>{{ hotel.data.title }}</h3>
                  <p>{{ hotel.data.subtitle }}</p>
                </div>
              </a>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endfor %}

    {% set fallbackHotels = allHotels | whereEquals("data.tier", undefined) %}
    {% if fallbackHotels.length %}
      <div class="hotel-group">
        <h2>Отели</h2>
        <div class="hotel-grid">
          {% for hotel in fallbackHotels %}
            <a class="hotel-card hotel-card-link" href="/hotels/{{ hotel.data.country }}/{{ hotel.data.slug }}/">
              <div class="hotel-card-image" style="background-image: url('{{ hotel.data.cover }}');"></div>
              <div class="hotel-card-body">
                <span class="hotel-card-rating">{{ hotel.data.stars or "★★★★★" }}{% if hotel.data.location %} <b>{{ hotel.data.location }}</b>{% endif %}</span>
                <h3>{{ hotel.data.title }}</h3>
                <p>{{ hotel.data.subtitle }}</p>
              </div>
            </a>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if not allHotels.length %}
      <p class="section-lead">Отели для этого направления скоро появятся.</p>
    {% endif %}

    <div class="country-top-action">
      <a class="ghost-button country-ghost-button" href="#top">Наверх <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg></a>
    </div>
  </section>
</main>
