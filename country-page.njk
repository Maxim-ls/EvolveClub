---
pagination:
  data: collections.publishedCountry
  size: 1
  alias: country
permalink: "{% if country.data.published !== false %}/countries/{{ country.data.slug }}/{% else %}false{% endif %}"
layout: layouts/base.njk
bodyClass: "country-page"
eleventyComputed:
  title: "{{ country.data.seo_title or country.data.title + ' - EvolveClub' }}"
  description: "{{ country.data.seo_description or country.data.subtitle }}"
---

<main id="top">
  <section class="country-hero" style="background-image: linear-gradient(90deg, rgba(17, 22, 21, .78), rgba(17, 22, 21, .46) 46%, rgba(17, 22, 21, .22)), linear-gradient(0deg, rgba(17, 22, 21, .78), rgba(17, 22, 21, .08) 58%), url('{{ country.data.cover | optimizedImage }}');">
    <div class="country-hero-inner">
      <a class="country-back" data-history-back href="/#destinations" data-return-section="{{ country.data.region }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg> Назад</a>
      <h1>{{ country.data.title }}</h1>
      <p>{{ country.data.subtitle }}</p>
      <div class="country-actions" aria-label="Информация о направлении">
        {% if country.data.why_body %}
          <button type="button" class="primary-button" data-modal-open="{{ country.data.slug }}-why">Зачем ехать? <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
        {% endif %}
        {% if country.data.details_body %}
          <button type="button" class="ghost-button country-ghost-button" data-modal-open="{{ country.data.slug }}-details">Подробнее <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
        {% endif %}
        {% if not country.data.why_body and not country.data.details_body %}
          <a class="primary-button" href="#hotels">Смотреть отели <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
        {% endif %}
      </div>
    </div>
  </section>

  <section class="country-hotels" id="hotels">
    <div class="section-head">
      <div>
        <p class="eyebrow">Наши рекомендации</p>
      </div>
    </div>

    {% set tiers = [
      { value: "deluxe", label: "Deluxe" },
      { value: "premium", label: "Premium" },
      { value: "business", label: "Business" }
    ] %}
    {% set allHotels = collections.hotel | whereEquals("data.country", country.data.slug) | whereTruthy("data.published") | sortByOrder %}

    {% for tier in tiers %}
      {% set tierHotels = allHotels | whereEquals("data.tier", tier.value) %}
      {% if tierHotels.length %}
        <div class="hotel-group">
          <h2>{{ tier.label }}</h2>
          <div class="hotel-grid">
            {% for hotel in tierHotels %}
              <a class="hotel-card hotel-card-link" href="/hotels/{{ hotel.data.country }}/{{ hotel.data.slug }}/">
                <div class="hotel-card-image" style="background-image: url('{{ hotel.data.cover | optimizedImage }}');"></div>
                <div class="hotel-card-body">
                  <span class="hotel-card-rating">{{ hotel.data.stars or "★★★★★" }}{% if hotel.data.location %} <b>{{ hotel.data.location }}</b>{% endif %}</span>
                  <h3>{{ hotel.data.title }}</h3>
                  <p>{{ hotel.data.subtitle }}</p>
                </div>
              </a>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endfor %}

    {% set fallbackHotels = allHotels | whereEquals("data.tier", undefined) %}
    {% if fallbackHotels.length %}
      <div class="hotel-group">
        <h2>Отели</h2>
        <div class="hotel-grid">
          {% for hotel in fallbackHotels %}
            <a class="hotel-card hotel-card-link" href="/hotels/{{ hotel.data.country }}/{{ hotel.data.slug }}/">
              <div class="hotel-card-image" style="background-image: url('{{ hotel.data.cover | optimizedImage }}');"></div>
              <div class="hotel-card-body">
                <span class="hotel-card-rating">{{ hotel.data.stars or "★★★★★" }}{% if hotel.data.location %} <b>{{ hotel.data.location }}</b>{% endif %}</span>
                <h3>{{ hotel.data.title }}</h3>
                <p>{{ hotel.data.subtitle }}</p>
              </div>
            </a>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if not allHotels.length %}
      <p class="section-lead">Отели для этого направления скоро появятся.</p>
    {% endif %}

    <div class="country-top-action">
      <a class="ghost-button country-ghost-button" href="#top">Наверх <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg></a>
    </div>
  </section>
</main>

{% if country.data.why_body %}
  <div class="modal" id="{{ country.data.slug }}-why" data-modal aria-hidden="true">
    <div class="modal-backdrop" data-modal-close></div>
    <section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="{{ country.data.slug }}-why-title">
      <button type="button" class="modal-close" data-modal-close aria-label="Закрыть">×</button>
      <p class="eyebrow">{{ country.data.title }}</p>
      <h2 id="{{ country.data.slug }}-why-title">{{ country.data.why_title or "Зачем ехать?" }}</h2>
      <div class="modal-copy">
        {{ country.data.why_body | markdownify | safe }}
      </div>
    </section>
  </div>
{% endif %}

{% if country.data.details_body %}
  <div class="modal" id="{{ country.data.slug }}-details" data-modal aria-hidden="true">
    <div class="modal-backdrop" data-modal-close></div>
    <section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="{{ country.data.slug }}-details-title">
      <button type="button" class="modal-close" data-modal-close aria-label="Закрыть">×</button>
      <p class="eyebrow">{{ country.data.details_eyebrow or "Практическая информация" }}</p>
      <h2 id="{{ country.data.slug }}-details-title">{{ country.data.details_title or "Подробнее" }}</h2>
      <div class="modal-copy">
        {{ country.data.details_body | markdownify | safe }}
      </div>
    </section>
  </div>
{% endif %}
