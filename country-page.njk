---
pagination:
  data: collections.country
  size: 1
  alias: country
permalink: "/countries/{{ country.data.slug }}/"
layout: layouts/base.njk
title: "{{ country.data.seo_title or country.data.title + ' - EvolveClub' }}"
description: "{{ country.data.seo_description or country.data.subtitle }}"
bodyClass: "country-page"
---

<main id="top">
  <section class="country-hero" style="background-image: linear-gradient(90deg, rgba(17, 22, 21, .78), rgba(17, 22, 21, .46) 46%, rgba(17, 22, 21, .22)), linear-gradient(0deg, rgba(17, 22, 21, .78), rgba(17, 22, 21, .08) 58%), url('{{ country.data.cover }}');">
    <div class="country-hero-inner">
      <a class="country-back" data-history-back href="/#destinations"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg> Назад</a>
      <h1>{{ country.data.title }}</h1>
      <p>{{ country.data.subtitle }}</p>
      <div class="country-actions" aria-label="Информация о направлении">
        <a class="primary-button" href="#hotels">Смотреть отели <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
      </div>
    </div>
  </section>

  <section class="country-hotels" id="hotels">
    <div class="section-head">
      <div>
        <p class="eyebrow">Отели</p>
        <h2>{{ country.data.title }}</h2>
      </div>
      <p class="section-lead">{{ country.templateContent | safe }}</p>
    </div>

    <div class="hotel-grid">
      {% set hasHotels = false %}
      {% for hotel in collections.hotel %}
        {% if hotel.data.country == country.data.slug %}
          {% set hasHotels = true %}
          <a class="hotel-card hotel-card-link" href="/hotels/{{ hotel.data.country }}/{{ hotel.data.slug }}/">
            <div class="hotel-card-image" style="background-image: url('{{ hotel.data.cover }}');"></div>
            <div class="hotel-card-body">
              <span>
                {% for segment in hotel.data.segments %}
                  {{ segmentLabels[segment] or segment }}{% if not loop.last %}, {% endif %}
                {% endfor %}
              </span>
              <h3>{{ hotel.data.title }}</h3>
              <p>{{ hotel.data.subtitle }}</p>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>

    {% if not hasHotels %}
      <p class="section-lead">Отели для этого направления скоро появятся.</p>
    {% endif %}
  </section>
</main>
