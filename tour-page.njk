---
pagination:
  data: collections.publishedTour
  size: 1
  alias: tour
permalink: "{% if tour.data.published !== false %}/tours/{{ tour.data.slug }}/{% else %}false{% endif %}"
layout: layouts/base.njk
bodyClass: "country-page tour-detail-page"
eleventyComputed:
  title: "{{ tour.data.seo_title or tour.data.title + ' - EvolveClub' }}"
  description: "{{ tour.data.seo_description or tour.data.subtitle }}"
---

<main id="top">
  <section class="tour-page-hero" style="background-image: linear-gradient(90deg, rgba(16, 21, 20, .84), rgba(16, 21, 20, .52) 48%, rgba(16, 21, 20, .2)), linear-gradient(0deg, rgba(16, 21, 20, .86), rgba(16, 21, 20, .08) 58%), url('{{ tour.data.cover | optimizedImage }}');">
    <a class="country-back" data-history-back href="/#tours"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg> Назад к турам</a>
    <div class="tour-page-hero-copy">
      {% if tour.data.duration %}
        <span class="tour-page-kicker">{{ tour.data.duration }}</span>
      {% endif %}
      <h1>{{ tour.data.title }}</h1>
      <span class="tour-hero-location"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M3 6.5 9 4l6 2.5 6-2.5v13.5L15 20l-6-2.5L3 20z"/><path d="M9 4v13.5"/><path d="M15 6.5V20"/></svg>{{ tour.data.destination }}</span>
    </div>
    <div class="tour-page-actions">
      <button type="button" class="primary-button" data-modal-open="tour-request">Выбрать тур</button>
      <a class="ghost-button country-ghost-button" href="#route">Смотреть программу</a>
    </div>
    <div class="tour-hero-facts" aria-label="Краткая информация о туре">
      {% if tour.data.hero_facts and tour.data.hero_facts.length %}
        {% for fact in tour.data.hero_facts %}
          <div>
            <span>
              {% if loop.index == 1 %}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11v8"/><path d="M21 11v8"/><path d="M5 11V7a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v4"/><path d="M3 15h18"/><path d="M7 11h10"/></svg>
              {% elif loop.index == 2 %}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3v18"/><path d="M10 3v18"/><path d="M6 9h4"/><path d="M18 3c-2 2-3 4.5-3 8h4v10"/></svg>
              {% else %}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 15.5V8a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v7.5"/><path d="M5 15h14"/><path d="M8 19h.01"/><path d="M16 19h.01"/><path d="M8 9h8"/></svg>
              {% endif %}
              {{ fact.label }}
            </span>
            <b>{{ fact.text }}</b>
          </div>
        {% endfor %}
      {% else %}
        <div>
          <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><path d="M3 10h18"/><rect x="3" y="4" width="18" height="18" rx="2"/></svg>Длительность</span>
          <b>{{ tour.data.duration or "По запросу" }}</b>
        </div>
        <div>
          <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>Направление</span>
          <b>{{ tour.data.destination }}</b>
        </div>
      {% endif %}
    </div>
  </section>

  <section class="tour-page-main" id="details">
    <section class="tour-intro">
      <div>
        <h2>{{ tour.data.intro_title or tour.data.subtitle }}</h2>
        {{ tour.templateContent | safe }}
      </div>
      <div class="tour-intro-side">
        <img src="{{ (tour.data.intro_image or tour.data.cover) | optimizedImage }}" alt="{{ tour.data.title }}" loading="lazy">
      </div>
    </section>

    {% if tour.data.route and tour.data.route.length %}
      <section class="tour-section" id="route">
        <h2>{{ tour.data.route_title or "Основная линия поездки" }}</h2>
        <div class="tour-route-line">
          {% for point in tour.data.route %}
            <div><b>{{ "0" if loop.index < 10 }}{{ loop.index }}</b><span>{{ point.title or point }}</span></div>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if tour.data.days and tour.data.days.length %}
      <section class="tour-section" id="program">
        <h2>{{ tour.data.program_title or "По дням" }}</h2>
        <div class="tour-day-list">
          {% for day in tour.data.days %}
            <article>
              <div class="tour-day-copy">
                <div class="tour-day-main">
                  <span>{{ day.title }}</span>
                  <p>{{ day.description }}</p>
                </div>
                {% if day.hotel or day.meals %}
                  <dl>
                    {% if day.hotel %}<div><dt>Отель</dt><dd>{{ day.hotel }}</dd></div>{% endif %}
                    {% if day.meals %}<div><dt>Питание</dt><dd>{{ day.meals }}</dd></div>{% endif %}
                  </dl>
                {% endif %}
              </div>
              {% if day.image %}
                <img src="{{ day.image | optimizedImage }}" alt="{{ day.image_alt or day.title }}" loading="lazy">
              {% endif %}
            </article>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if tour.data.info_sections and tour.data.info_sections.length %}
      <div class="tour-standalone-grid">
        {% for section in tour.data.info_sections %}
          <section class="tour-section">
            <h2>{{ section.title }}</h2>
            {% if section.items and section.items.length %}
              <ul>
                {% for item in section.items %}
                  <li>{{ item.text or item }}</li>
                {% endfor %}
              </ul>
            {% elif section.body %}
              <p>{{ section.body }}</p>
            {% endif %}
          </section>
        {% endfor %}
      </div>
    {% endif %}

    {% if tour.data.fit_title or tour.data.fit_body %}
      <section class="tour-section tour-fit">
        <div>
          {% if tour.data.fit_title %}<h2>{{ tour.data.fit_title }}</h2>{% endif %}
          {% if tour.data.fit_body %}<p>{{ tour.data.fit_body }}</p>{% endif %}
        </div>
      </section>
    {% endif %}

    {% if tour.data.gallery and tour.data.gallery.length %}
      <section class="tour-section">
        <span>Фото</span>
        <h2>Галерея</h2>
        <div class="hotel-photo-mosaic">
          {% for item in tour.data.gallery %}
            <img src="{{ (item.image or item) | optimizedImage }}" alt="{{ tour.data.title }}" loading="lazy">
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <div class="hotel-bottom-action">
      <a class="ghost-button country-ghost-button" href="#top">Наверх <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg></a>
      <button type="button" class="primary-button" data-modal-open="tour-request">Выбрать тур</button>
    </div>
  </section>
</main>

<div class="modal" id="tour-request" data-modal aria-hidden="true">
  <div class="modal-backdrop" data-modal-close></div>
  <div class="modal-panel request-modal-panel" role="dialog" aria-modal="true" aria-labelledby="tour-request-title">
    <button type="button" class="modal-close" data-modal-close aria-label="Закрыть">×</button>
    <h2 id="tour-request-title">Выбрать тур</h2>
    <form class="request-form" action="/send-request" method="post" data-request-form>
      <label for="tour-request-name"><span>Имя</span><input type="text" id="tour-request-name" name="name" placeholder="Ваше имя" required></label>
      <label for="tour-request-contact"><span>Контакт</span><input type="text" id="tour-request-contact" name="contact" placeholder="+7 (925) 141-50-10" required></label>
      <div class="request-date-grid">
        <label for="tour-request-date-start"><span>Начало поездки</span><input type="date" id="tour-request-date-start" name="date_start"></label>
        <label for="tour-request-date-end"><span>Конец поездки</span><input type="date" id="tour-request-date-end" name="date_end"></label>
      </div>
      <label for="tour-request-message"><span>Пожелания</span><textarea id="tour-request-message" name="message" rows="4" placeholder="Количество гостей и важные детали">Интересует тур «{{ tour.data.title }}».</textarea></label>
      <button type="submit" class="primary-button">Отправить заявку</button>
      <p class="form-status" data-form-status></p>
    </form>
  </div>
</div>
