---
pagination:
  data: collections.hotel
  size: 1
  alias: hotel
permalink: "/hotel-test/{{ hotel.data.slug }}/"
layout: layouts/base.njk
title: "{{ hotel.data.title }}"
---

<main style="padding: 40px;">
  <h1>{{ hotel.data.title }}</h1>
  <p>{{ hotel.data.subtitle }}</p>

  <p>
    <strong>Страна:</strong> {{ hotel.data.country }}
  </p>

  <p>
    <strong>Сегменты:</strong>
    {% for segment in hotel.data.segments %}
      {{ segment }}{% if not loop.last %}, {% endif %}
    {% endfor %}
  </p>

  <img
    src="{{ hotel.data.cover }}"
    alt="{{ hotel.data.title }}"
    style="max-width: 600px; width: 100%; height: auto;"
  >

  <div>
    {{ hotel.templateContent | safe }}
  </div>
</main>
